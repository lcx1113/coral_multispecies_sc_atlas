<config>
    <!-- droptag -->
    <TagsSearch>
        <protocol>split_seq</protocol>
        <MultipleBarcodeSearch>
            <barcode_starts>0 20 40</barcode_starts>
            <barcode_lengths>10 10 10</barcode_lengths>
            <umi_start>50</umi_start>
            <umi_length>8</umi_length>
        </MultipleBarcodeSearch>

        <Processing>
            <min_align_length>10</min_align_length>
            <reads_per_out_file>10000000000000000</reads_per_out_file>
        </Processing>
    </TagsSearch>

    <!-- dropest -->
    <Estimation>
        <Merge>
            <barcodes_file>/absolute/path/to/repository/data_processing/read_processing_quantification/config/barcode123_rc.txt</barcodes_file>
            <barcodes_type>const</barcodes_type>
            <max_cb_merge_edit_distance>1</max_cb_merge_edit_distance>
            <max_umi_merge_edit_distance>1</max_umi_merge_edit_distance>
            <min_genes_after_merge>0</min_genes_after_merge>
            <min_genes_before_merge>0</min_genes_before_merge>
        </Merge>
    </Estimation>
</config>
